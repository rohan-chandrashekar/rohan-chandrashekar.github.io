---
import BaseLayout from '../layouts/BaseLayout.astro';
import ResearchExplorer from '../components/ResearchExplorer';
import { profile } from '../lib/constants/profile';
---

<BaseLayout title={`${profile.name} — Publications & Research`} description="Peer-reviewed publications, conference talks, journal submissions, and technical white papers by Rohan Chandrashekar.">
  <div class="mt-6">
    <h1 class="page-title">Publications & Research</h1>
    <div class="accent-bar"></div>
<p class="page-subtitle">
      Peer-reviewed papers, conference talks, journal submissions, and white papers — directly linked, with one-click BibTeX.
    </p>
  </div>

  <div class="mt-8">
    <ResearchExplorer client:load items={profile.research} />
  </div>
</BaseLayout>
